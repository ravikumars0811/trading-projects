# User Service Environment Variables
USER_SERVICE_NAME=user-service
USER_DATABASE_URL=postgresql+asyncpg://admin:admin123@postgres:5432/microservices_db
USER_REDIS_URL=redis://redis:6379
USER_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Product Service Environment Variables
PRODUCT_SERVICE_NAME=product-service
PRODUCT_DATABASE_URL=postgresql+asyncpg://admin:admin123@postgres:5432/microservices_db
PRODUCT_REDIS_URL=redis://redis:6379
PRODUCT_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Order Service Environment Variables
ORDER_SERVICE_NAME=order-service
ORDER_DATABASE_URL=postgresql+asyncpg://admin:admin123@postgres:5432/microservices_db
ORDER_REDIS_URL=redis://redis:6379
ORDER_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ORDER_USER_SERVICE_URL=http://user-service:8000
ORDER_PRODUCT_SERVICE_URL=http://product-service:8000

# Inventory Service Environment Variables
INVENTORY_SERVICE_NAME=inventory-service
INVENTORY_MONGODB_URL=mongodb://admin:admin123@mongodb:27017/inventory_db?authSource=admin
INVENTORY_REDIS_URL=redis://redis:6379
INVENTORY_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Notification Service Environment Variables
NOTIFICATION_SERVICE_NAME=notification-service
NOTIFICATION_REDIS_URL=redis://redis:6379
NOTIFICATION_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Frontend Environment Variables
REACT_APP_USER_SERVICE_URL=http://localhost:8001
REACT_APP_PRODUCT_SERVICE_URL=http://localhost:8002
REACT_APP_ORDER_SERVICE_URL=http://localhost:8003
REACT_APP_INVENTORY_SERVICE_URL=http://localhost:8004
REACT_APP_NOTIFICATION_SERVICE_URL=http://localhost:8005

# Database Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=microservices_db

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin123
MONGO_INITDB_DATABASE=inventory_db

# Kafka Configuration
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

# Security (Change in production!)
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS Configuration (for production deployment)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Monitoring
PROMETHEUS_RETENTION_TIME=15d
GRAFANA_ADMIN_PASSWORD=admin123

# Logging
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
LOGSTASH_PORT=5000
KIBANA_PORT=5601

# Database Configuration
DATABASE_URL=postgresql+asyncpg://watchdog360:yourpassword@localhost:5432/watchdog360
TIMESCALEDB_ENABLED=true

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=Watchdog360
DEBUG=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://dashboard.watchdog360.com

# AI/ML Configuration
ANOMALY_DETECTION_ENABLED=true
ANOMALY_DETECTION_THRESHOLD=0.85
PREDICTION_ENABLED=true

# Alerts
ALERT_HIGH_CPU_THRESHOLD=80
ALERT_HIGH_MEMORY_THRESHOLD=85
ALERT_HIGH_DISK_THRESHOLD=90
